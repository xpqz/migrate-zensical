# Zensical build output and incremental cache. The generated project lives at
# /zensical/; its site/ and .cache/ are build artefacts, not source.
/zensical/site/
/zensical/.cache/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# OS
.DS_Store

# CHM build output (tools/chm/build_chm.py --project-dir out/chm)
/out/
