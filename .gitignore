# Zensical build output and incremental cache: build artefacts, not source.
# The project lives at /zensical/ until the cutover, at the root after it.
/zensical/site/
/zensical/.cache/
/site/
/.cache/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# OS
.DS_Store

# CHM build output (tools/chm/build_chm.py --project-dir out/chm)
/out/

# code-blocks.py review log (tools/cutover/code-blocks.py) and its backup
/code-blocks.yml
/code-blocks.yml.bak

# Offline bundle: generated config and its build output (archives go to /out/)
/zensical/offline.toml
/zensical/site-offline/
