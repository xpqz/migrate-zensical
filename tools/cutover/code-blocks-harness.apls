#!/usr/bin/env dyalogscript
⍝ Harness for code-blocks.py: runs request lines the way a session would display them.
⍝ Usage: dyalogscript DYALOG_INITSESSION=1 code-blocks-harness.apls request.json
⍝ Protocol (stdout, lines end in CR), <t> being the request's random token:
⍝ "⍝CB-<t>-BEGIN <id> <index>" before each input line, then "⍝CB-<t>-END" (plain),
⍝ "⍝CB-<t>-END ERROR", "⍝CB-<t>-END SKIP" (system command) or "⍝CB-<t>-END SKIP QQ" (⍞).
⍝ A request line is an input unit: a string (one session line) or a list of strings
⍝ (several lines run as source, or a typed ∇ definition: see Unit, Define); each unit
⍝ gets one BEGIN/END pair.
⍝ The harness code is the ⍝| lines below, fixed into ⎕SE.CB (out of reach of user code);
⍝ user lines execute in #.
args←2⎕NQ'.' 'GetCommandLineArgs'
src←⊃⎕NGET(⊃⌽args/⍨'.apls'∘≡¨¯5↑¨args)1
{}⎕SE.⎕FIX 2↓¨src/⍨'⍝|'∘≡¨2↑¨src
⎕SE.CB.Main⊃⌽args
⎕OFF
⍝|:Namespace CB
⍝|    ⎕IO←1 ⋄ ⎕ML←1
⍝|
⍝|    ∇ Main file;req;blk;i;lines;tok;unitfn
⍝|      req←⎕JSON⊃⎕NGET file
⍝|      {}#.⎕EX'args' 'src'  ⍝ the bootstrap's names must not reach user code
⍝|      tok←'⍝CB-',req.token,'-'
⍝|      unitfn←'⍙CB',req.token  ⍝ Unit's temporary function in #
⍝|      #.⎕IO←1 ⋄ #.⎕ML←1 ⋄ ⎕PW←req.pw
⍝|      :For blk :In ,req.blocks
⍝|          :If ⎕NULL≢blk.style
⍝|              Style blk.style
⍝|          :EndIf
⍝|          lines←,¨⊆blk.lines
⍝|          :For i :In ⍳≢lines
⍝|              ⎕←tok,'BEGIN ',(⍕blk.id),' ',⍕i-1
⍝|              ⎕←tok,'END',(1+Run i⊃lines)⊃'' ' ERROR' ' SKIP' ' SKIP QQ'
⍝|          :EndFor
⍝|      :EndFor
⍝|    ∇
⍝|
⍝|    ∇ Style s;_
⍝|      :Trap 0
⍝|          :Select s
⍝|          :Case 'max' ⋄ _←⎕SE.UCMD'box on -style=max'
⍝|          :Case 'min' ⋄ _←⎕SE.UCMD'box on -style=min'
⍝|          :Case 'off' ⋄ _←⎕SE.UCMD'box off'
⍝|          :EndSelect
⍝|      :EndTrap
⍝|    ∇
⍝|
⍝|    ⍝ An input unit is one line (a string), run as a session line, or several lines (a
⍝|    ⍝ vector of strings), run as source.
⍝|    ∇ state←Run unit
⍝|      :If 1≥|≡unit
⍝|          state←Line unit
⍝|      :Else
⍝|          state←Unit unit
⍝|      :EndIf
⍝|    ∇
⍝|
⍝|    ⍝ Run several lines as literal source: fixed as the body of a niladic function in # and
⍝|    ⍝ called there, so names they assign are #'s. Result as for Line; an error displays its
⍝|    ⍝ message only (a definition that does not fix: DEFN ERROR). A line that is a system
⍝|    ⍝ command or uses ⎕OFF skips the unit (2), as does ⍞ (3). Only output the lines send
⍝|    ⍝ to ⎕ (or ⍞) is displayed: other values, as in a function called by ⍎, are not.
⍝|    ∇ state←Unit src;t;r;sc
⍝|      :If '∇'=⊃{(∨\⍵≠' ')/⍵}(⊃src),' '
⍝|          state←Define src ⋄ :Return
⍝|      :EndIf
⍝|      sc←Scan¨src
⍝|      t←{(∨\⍵≠' ')/⍵}¨src
⍝|      :If ∨/(')'=⊃¨t,¨' ')∨3⊃¨sc
⍝|          state←2 ⋄ :Return
⍝|      :EndIf
⍝|      :If ∨/2⊃¨sc
⍝|          state←3 ⋄ :Return
⍝|      :EndIf
⍝|      state←0
⍝|      :Trap 0
⍝|          r←#.⎕FX(⊂unitfn),src
⍝|      :Else
⍝|          r←⍬
⍝|      :EndTrap
⍝|      :If ~unitfn≡r
⍝|          ⎕←'DEFN ERROR' ⋄ state←1 ⋄ :Return
⍝|      :EndIf
⍝|      :Trap 0
⍝|          #.⍎unitfn
⍝|      :Else
⍝|          state←1
⍝|          ⎕←⎕DMX.EM,(0<≢⎕DMX.Message)/': ',⎕DMX.Message
⍝|      :EndTrap
⍝|      {}#.⎕EX unitfn
⍝|    ∇
⍝|
⍝|    ⍝ A typed ∇ definition (header, body lines, closing ∇) is fixed in # with ⎕FX and,
⍝|    ⍝ as in the session, displays nothing; one that does not fix displays DEFN ERROR.
⍝|    ⍝ Defining runs none of its lines.
⍝|    ∇ state←Define src;r
⍝|      r←(⊂{(∨\⍵≠' ')/⍵}1↓{(∨\⍵≠' ')/⍵}⊃src),1↓¯1↓src
⍝|      state←0
⍝|      :Trap 0
⍝|          r←#.⎕FX r
⍝|      :Else
⍝|          r←⍬
⍝|      :EndTrap
⍝|      :If ~(0<≢r)∧0=2|⎕DR r
⍝|          ⎕←'DEFN ERROR' ⋄ state←1
⍝|      :EndIf
⍝|    ∇
⍝|
⍝|    ⍝ Scan a line outside quoted strings and comments. Result: seps qq off, where seps are
⍝|    ⍝ the indices of top-level ⋄ (not inside {} [] ()), qq says whether ⍞ occurs and off
⍝|    ⍝ whether the ⎕OFF token occurs (any case).
⍝|    ∇ r←Scan text;i;c;depth;q;seps;qq;off;n;nm
⍝|      seps←⍬ ⋄ qq←off←depth←q←0 ⋄ n←≢text ⋄ i←0
⍝|      :While i<n
⍝|          i+←1 ⋄ c←i⊃text
⍝|          :If q
⍝|              q←c≠''''
⍝|              :Continue
⍝|          :EndIf
⍝|          :Select c
⍝|          :Case ''''
⍝|              q←1
⍝|          :Case '⍝'
⍝|              :Leave
⍝|          :CaseList '{' '[' '('
⍝|              depth+←1
⍝|          :CaseList '}' ']' ')'
⍝|              depth←0⌈depth-1
⍝|          :Case '⋄'
⍝|              seps,←(depth=0)/i
⍝|          :Case '⍞'
⍝|              qq←1
⍝|          :Case '⎕'
⍝|              nm←⎕C i↓text
⍝|              nm←(∧\nm∊'abcdefghijklmnopqrstuvwxyz0123456789_∆⍙')/nm
⍝|              off∨←nm≡'off'
⍝|          :EndSelect
⍝|      :EndWhile
⍝|      r←seps qq off
⍝|    ∇
⍝|
⍝|    ⍝ Display a value as the session would. ⎕← inside a function bypasses the ]box output
⍝|    ⍝ filter (it only sees top-level output), so with boxing on we ask the filter for the
⍝|    ⍝ formatted lines and print those.
⍝|    ∇ Show v;out
⍝|      ⎕PP←#.⎕PP
⍝|      :If 2=⌊⎕NC'⎕SE.Dyalog.Out.B.state'
⍝|      :AndIf 'on'≡⎕SE.Dyalog.Out.B.state
⍝|          ⍝ simulation mode formats per view; event 3 = suspended + return the lines
⍝|          ⎕SE.Dyalog.Out.B.view←⎕SE.Dyalog.Out.B.style
⍝|          out←v ⎕SE.Dyalog.Out.Filter 3
⍝|          {⎕←⍵}¨out
⍝|      :Else
⍝|          ⎕←v
⍝|      :EndIf
⍝|    ∇
⍝|
⍝|    ⍝ Run one input line; result 0 = ran, 1 = error displayed, 2 = skipped (system command),
⍝|    ⍝ 3 = skipped (uses ⍞). The line is split into statements at top-level ⋄.
⍝|    ∇ state←Line text;t;seps;qq;off;starts;ends;k;stmt;s;lead;q
⍝|      cur←text ⋄ state←0
⍝|      t←(∨\text≠' ')/text
⍝|      :If 0=≢t
⍝|          :Return
⍝|      :EndIf
⍝|      seps qq off←Scan text
⍝|      :If (')'=⊃t)∨off
⍝|          state←2 ⋄ :Return
⍝|      :EndIf
⍝|      :If qq
⍝|          state←3 ⋄ :Return
⍝|      :EndIf
⍝|      :If ']'=⊃t
⍝|          ⍝ Run from # so the command's argument sees user names; a command
⍝|          ⍝ such as ]Display prints and has no result (error 85).
⍝|          cur←'⎕SE.UCMD ',q,((1+q=s)/s←1↓t),q←''''
⍝|          :Trap 0
⍝|              Show #.⍎'1(85⌶)⎕SE.CB.cur'
⍝|          :Else
⍝|              :If 85≠⎕DMX.EN
⍝|                  state←1
⍝|                  {⎕←⍵}¨Err text 0 text
⍝|              :EndIf
⍝|          :EndTrap
⍝|          :Return
⍝|      :EndIf
⍝|      starts←1,seps+1
⍝|      ends←(seps,1+≢text)-1
⍝|      :For k :In ⍳≢starts
⍝|          stmt←(starts[k]-1)↓ends[k]↑text
⍝|          s←(∨\stmt≠' ')/stmt
⍝|          lead←(starts[k]-1)+(≢stmt)-≢s
⍝|          s←⌽(∨\' '≠⌽s)/⌽s
⍝|          :If (0=≢s)∨(⊃s)∊'⍝→'
⍝|              :Continue
⍝|          :EndIf
⍝|          cur←stmt
⍝|          :Trap 0
⍝|              :If 0<≢('^\s*⎕TRAP\b[^''←]*←'⎕S 0⍠'IC' 1)stmt
⍝|                  ⍝ A statement that assigns ⎕TRAP (also ⎕TRAP f←) can end the
⍝|                  ⍝ interpreter under 85⌶ (Dyalog 21.0). Its value is shy, so run it
⍝|                  ⍝ plainly. The assignment does not outlive the statement, so the
⍝|                  ⍝ harness's :Trap still catches later errors.
⍝|                  #.⍎cur
⍝|              :Else
⍝|                  Show #.⍎'1(85⌶)⎕SE.CB.cur'
⍝|              :EndIf
⍝|          :Else
⍝|              :If 85≠⎕DMX.EN
⍝|                  state←1
⍝|                  {⎕←⍵}¨Err s(lead)text
⍝|              :EndIf
⍝|          :EndTrap
⍝|          :If state=1
⍝|              :Leave
⍝|          :EndIf
⍝|      :EndFor
⍝|    ∇
⍝|
⍝|    ⍝ Session display of the current error. Error in the statement itself: the message, the
⍝|    ⍝ whole line and a caret under the position (the statement starts `lead` characters into
⍝|    ⍝ the line). Error inside a called function: the message, then Dyalog own function
⍝|    ⍝ line and caret.
⍝|    ∇ r←Err arg;stmt;lead;line;dm;c;p;pfx
⍝|      stmt lead line←arg
⍝|      r←,⊂⎕DMX.EM,(0<≢⎕DMX.Message)/': ',⎕DMX.Message
⍝|      dm←⎕DMX.DM
⍝|      pfx←'Line['
⍝|      :If 2>≢dm
⍝|          :Return
⍝|      :EndIf
⍝|      :If (pfx≡(≢pfx)↑2⊃dm)∨~0<≢'^\S+\[\d+\]'⎕S 0⊢2⊃dm
⍝|          :If 3=≢dm
⍝|              p←(≢2⊃dm)-≢stmt
⍝|              c←(3⊃dm)⍳'∧'
⍝|              :If (c≤≢3⊃dm)∧c>p
⍝|                  r,←(⊂'      ',line),⊂((5+lead+c-p)⍴' '),'∧'
⍝|              :EndIf
⍝|          :EndIf
⍝|      :Else
⍝|          r,←1↓dm
⍝|      :EndIf
⍝|    ∇
⍝|:EndNamespace
